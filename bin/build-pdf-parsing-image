#!/usr/bin/env bash
# Build the pdf-parsing service image with Cloud Build, and roll the service
# onto it.
#
#   bin/build-pdf-parsing-image [--no-deploy]
#
# Builds us-east4-docker.pkg.dev/clingen-caa/pdf-parsing/server:<base>-<sha>
# from docling-serve-cu128:<base> (infrastructure/pdf-parsing/base-tag,
# through the ghcr proxy repository) plus the layout override, see
# infrastructure/pdf-parsing/Dockerfile; <sha> is the short commit of HEAD.
# Then updates the Cloud Run service's image, unless --no-deploy. This is
# what .github/workflows/pdf-parsing-image.yml runs on a push to main; by
# hand it needs the right to act as the builder account (terraform:
# var.invokers). About ten minutes, most of it pulling the base image.
set -euo pipefail

deploy=true
[[ "${1:-}" == "--no-deploy" ]] && deploy=false

project=clingen-caa
region=us-east4
service=pdf-parsing
builder="pdf-parsing-builder@${project}.iam.gserviceaccount.com"
registry="${region}-docker.pkg.dev/${project}"

root="$(cd "$(dirname "$0")/.." && pwd)"
base_tag="$(tr -d '[:space:]' < "$root/infrastructure/pdf-parsing/base-tag")"
sha="$(git -C "$root" rev-parse --short=7 HEAD)"
base_image="${registry}/ghcr/docling-project/docling-serve-cu128:${base_tag}"
image="${registry}/pdf-parsing/server:${base_tag}-${sha}"

context="$(mktemp -d)"
trap 'rm -rf "$context"' EXIT
cp "$root/infrastructure/pdf-parsing/Dockerfile" \
   "$root/infrastructure/pdf-parsing/sitecustomize.py" \
   "$root/infrastructure/pdf-parsing/cloudbuild.yaml" \
   "$root/lib/misc/pdf/layout.py" \
   "$context/"

echo "building $image"
gcloud builds submit "$context" \
  --project="$project" --region="$region" \
  --config="$context/cloudbuild.yaml" \
  --service-account="projects/${project}/serviceAccounts/${builder}" \
  --gcs-source-staging-dir="gs://${project}-pdf-parsing-build/source" \
  --substitutions="_BASE_IMAGE=${base_image},_IMAGE=${image}"
echo "built $image"

if $deploy; then
  gcloud run services update "$service" \
    --project="$project" --region="$region" --image="$image" --quiet
  echo "deployed $image"
fi
