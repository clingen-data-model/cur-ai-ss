# Settings for NcbiLookupClient
# If NcbiLookupClient is used and these settings are omitted, NCBI calls are rate-limited to 3rps instead of 10rps.
NCBI_EUTILS_API_KEY="<key>" # [optional] NCBI API key
NCBI_EUTILS_EMAIL="<email>" # [optional] Email address associated with key

# Model selection: '<provider>/<model>' names, prefix required. 'openai/' and
# 'anthropic/' route today; anything else is rejected at settings load, as is
# a model whose provider key is missing. The two may differ -- vision can run
# on Claude while extraction stays on OpenAI. EXTRACTION_MODEL cannot move to
# 'anthropic/' yet; see docs/anthropic-migration.md.
# EXTRACTION_MODEL=openai/gpt-5.6-luna
# VLM_MODEL=openai/gpt-5.6-sol
# OPENAI_API_KEY=sk-...
# ANTHROPIC_API_KEY=sk-ant-...
