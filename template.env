# Settings for NCBI lookups. If these are omitted, NCBI calls are rate-limited
# to 3 requests/s instead of 10. NCBI_EMAIL is required when NCBI_API_KEY is set.
# NCBI_API_KEY=
# NCBI_EMAIL=<email>

# Signs login tokens. Required; use a long random value in production.
JWT_SECRET_KEY=

# Model selection: '<provider>/<model>' names, prefix required. 'anthropic/' and
# 'openai/' both route; anything else is rejected at settings load, as is a
# model whose provider key is missing. The three settings may name different
# providers. CHAT_MODEL defaults to anthropic/claude-opus-5, so an Anthropic key
# is needed unless CHAT_MODEL is changed too.
ANTHROPIC_API_KEY=
EXTRACTION_MODEL=anthropic/claude-haiku-5-5
VLM_MODEL=anthropic/claude-fable-5-1
# CHAT_MODEL=anthropic/claude-opus-5
# OPENAI_API_KEY=
