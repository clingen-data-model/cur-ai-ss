# A template unit: worker@0 ... worker@{{ worker_count - 1 }} run at once, each
# owning the papers whose id % WORKER_COUNT is its instance number
# (lib/bin/worker.py, shard_filter). The count is written into every instance
# so they agree on the sharding; a change to worker_count restarts them all.
[Unit]
Description=Curator AI Background Worker %i of {{ worker_count }}
After=network-online.target curator-api.service
Wants=network-online.target curator-api.service

[Service]
Type=simple
WorkingDirectory=/opt/{{ caa_user }}
EnvironmentFile=/opt/{{ caa_user }}/.env
Environment=PATH="/home/{{ caa_user }}/.local/bin:/usr/local/bin:/usr/bin:/bin"
Environment=PROTOCOL="https://"
Environment=API_ENDPOINT="{{ domain }}/api"
Environment=WORKER_ID=%i
Environment=WORKER_COUNT={{ worker_count }}

ExecStart=/opt/{{ caa_user }}/bin/worker

# Headroom for the per-task SQLiteSession connections (lib/tasks/agent_session.py):
# the default 1024 ran out after ~500 task runs on 2026-09-30, before the
# worker closed sessions, and every later SQLite open in the process failed.
LimitNOFILE=2048

Restart=on-failure
RestartSec=5

StandardOutput=journal
StandardError=journal
SyslogIdentifier=curator-worker-%i

[Install]
WantedBy=default.target
