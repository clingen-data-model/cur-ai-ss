# Curator environment variables
# Generated by Ansible - do not edit manually on the VM
#
# This file contains sensitive credentials and should not be committed to git.

# CAA configuration
CAA_ROOT="/var/{{ caa_user }}"

# Model provider keys. Both are always written; which one is actually used is
# decided by the provider prefix on EXTRACTION_MODEL / VLM_MODEL, whose defaults
# live in lib/core/environment.py. Env.validate_models refuses to load if a
# configured model names a provider whose key is missing, so the key has to be
# deployed before the model can be pointed at it.
OPENAI_API_KEY="{{ openai_api_key_content.stdout }}"
ANTHROPIC_API_KEY="{{ anthropic_api_key_content.stdout }}"

# Vision and text extraction both run on Claude here. Set here rather than by
# changing the defaults in lib/core/environment.py, because those defaults are
# also what a developer with no ANTHROPIC_API_KEY loads -- validate_models
# would refuse to construct Env at all, breaking local runs to configure
# production. EXTRACTION_MODEL used to be pinned to OpenAI because
# responses_api_model()'s server-side conversation_id had no Anthropic
# equivalent; that dependency is gone now that lib.tasks.agent_session gives
# every task its own provider-agnostic SQLiteSession (see
# docs/anthropic-migration.md), so extraction can run on Claude too. Moved
# from claude-haiku-4-5-20251001 to claude-sonnet-5-5 for extraction quality;
# confirmed the locked litellm==1.100.0 already recognizes claude-sonnet-5-5
# for both AnthropicModelInfo.supports_native_structured_output (avoids the
# forced tool_choice path Blocker 1 in docs/anthropic-migration.md warns
# about) and AnthropicConfig._model_supports_effort_param (so
# model_factory.py's effort gating keeps working) -- same as claude-sonnet-5,
# unlike claude-haiku-4-5-20251001 which rejects output_config.effort
# entirely. No live extraction smoke test was run against a real paper before
# this change (no ANTHROPIC_API_KEY available locally); do that against
# dev-caa after deploying, the way the MASP1 test paper (PMID 26419238)
# verified the original OpenAI-to-Claude extraction move.
VLM_MODEL="anthropic/claude-fable-5-1"
EXTRACTION_MODEL="anthropic/claude-sonnet-5-5"

# NCBI configuration
NCBI_API_KEY="{{ ncbi_api_key_content.stdout }}"
NCBI_EMAIL="{{ ncbi_email_content.stdout }}"

# CORS configuration
CORS_ALLOWED_ORIGINS="https://{{ domain }},http://localhost:8501"

# Auth / JWT configuration
JWT_SECRET_KEY="{{ auth_secrets.JWT_SECRET_KEY }}"
JWT_ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES="1440"

# SMTP configuration (registration / activation emails)
SMTP_HOST="smtp.gmail.com"
SMTP_PORT="587"
SMTP_USER="{{ auth_secrets.SMTP_USER }}"
SMTP_PASSWORD="{{ auth_secrets.SMTP_PASSWORD }}"
SMTP_FROM="{{ auth_secrets.SMTP_FROM }}"
