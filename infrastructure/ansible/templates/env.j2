# Curator environment variables
# Generated by Ansible - do not edit manually on the VM
#
# This file contains sensitive credentials and should not be committed to git.

# CAA configuration
CAA_ROOT="/var/{{ caa_user }}"

# Model provider keys. Both are always written; which one is actually used is
# decided by the provider prefix on EXTRACTION_MODEL / VLM_MODEL, whose defaults
# live in lib/core/environment.py. Env.validate_models refuses to load if a
# configured model names a provider whose key is missing, so the key has to be
# deployed before the model can be pointed at it.
OPENAI_API_KEY="{{ openai_api_key_content.stdout }}"
ANTHROPIC_API_KEY="{{ anthropic_api_key_content.stdout }}"

# Vision runs on Claude; text extraction stays on OpenAI. Set here rather than
# by changing the default in lib/core/environment.py, because that default is
# also what a developer with no ANTHROPIC_API_KEY loads -- validate_models would
# refuse to construct Env at all, breaking local runs to configure production.
# EXTRACTION_MODEL is deliberately left at its default: responses_api_model()
# raises for a non-OpenAI provider, since the chat follow-up turn and
# ensure_conversation_id still need OpenAI's server-side conversation state.
VLM_MODEL="anthropic/claude-fable-5-1"

# NCBI configuration
NCBI_API_KEY="{{ ncbi_api_key_content.stdout }}"
NCBI_EMAIL="{{ ncbi_email_content.stdout }}"

# CORS configuration
CORS_ALLOWED_ORIGINS="https://{{ domain }},http://localhost:8501"

# Auth / JWT configuration
JWT_SECRET_KEY="{{ auth_secrets.JWT_SECRET_KEY }}"
JWT_ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES="1440"

# SMTP configuration (registration / activation emails)
SMTP_HOST="smtp.gmail.com"
SMTP_PORT="587"
SMTP_USER="{{ auth_secrets.SMTP_USER }}"
SMTP_PASSWORD="{{ auth_secrets.SMTP_PASSWORD }}"
SMTP_FROM="{{ auth_secrets.SMTP_FROM }}"
