      "isDeleted": false,
      "boundElements": [],
      "updated": 1,
      "link": null,
      "locked": false,
      "text": "Reviews the finished extraction and merges\nflags that raise the same decision more than\nonce.\n\nRuns on: deterministic (no model); queued by\nthe worker when everything else has settled\n\nWrites: flags merged; completion snapshot and\nthe owner's email\n\nScope: whole paper",
      "originalText": "Reviews the finished extraction and merges\nflags that raise the same decision more than\nonce.\n\nRuns on: deterministic (no model); queued by\nthe worker when everything else has settled\n\nWrites: flags merged; completion snapshot and\nthe owner's email\n\nScope: whole paper",
      "fontSize": 13,
      "fontFamily": 2,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "lineHeight": 1.25,
      "autoResize": true
