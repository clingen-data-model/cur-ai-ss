      "boundElements": [],
      "updated": 1,
      "link": null,
      "locked": false,
      "text": "Decides whether the paper has identifiable\ncases for this gene worth extracting; if not,\nthe pipeline stops.\n\nRuns on: EXTRACTION_MODEL\n\nWrites: papers.is_paper_relevant + its basis;\na \"no\" ends the pipeline\n\nScope: whole paper",
      "originalText": "Decides whether the paper has identifiable\ncases for this gene worth extracting; if not,\nthe pipeline stops.\n\nRuns on: EXTRACTION_MODEL\n\nWrites: papers.is_paper_relevant + its basis;\na \"no\" ends the pipeline\n\nScope: whole paper",
      "fontSize": 13,
      "fontFamily": 2,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "lineHeight": 1.25,
      "autoResize": true
