      "versionNonce": 1535278884,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1,
      "link": null,
      "locked": false,
      "text": "Calculates segregation counts and points for\neach family from its extracted patients and\nvariants.\n\nRuns on: deterministic (no model), per family\n\nWrites: segregation_analysis_computed: counts\nand points per family\n\nScope: per family",
      "originalText": "Calculates segregation counts and points for\neach family from its extracted patients and\nvariants.\n\nRuns on: deterministic (no model), per family\n\nWrites: segregation_analysis_computed: counts\nand points per family\n\nScope: per family",
      "fontSize": 13,
      "fontFamily": 2,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "lineHeight": 1.25,
      "autoResize": true
